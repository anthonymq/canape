<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <solid android:color="#101827" />
        </shape>
    </item>
    <item android:width="88dp" android:height="88dp"
        android:gravity="left|center_vertical" android:left="20dp">
        <bitmap android:src="@mipmap/ic_launcher" android:gravity="fill" android:filter="true" />
    </item>
    <item android:width="176dp" android:height="52dp"
        android:gravity="left|center_vertical" android:left="120dp"
        android:drawable="@drawable/canape_wordmark" />
</layer-list>
